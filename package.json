{
  "name": "web-ide",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @webide/web",
    "build": "npm run build -w @webide/web",
    "start": "npm run start -w @webide/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
